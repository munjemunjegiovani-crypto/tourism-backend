# Copy this file to .env and fill in the values.

# Postgres connection string. For Neon, copy it from the Neon dashboard (keep ?sslmode=require).
# Local example: postgres://postgres:postgres@localhost:5432/tourism
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tourism

# Port the API listens on
PORT=4000

# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:3000

# Any long random string; used to hash visitor IPs in click logs
IP_HASH_SALT=change-me-to-a-long-random-string

NODE_ENV=development
